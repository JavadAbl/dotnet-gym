{
  "Database": {
    "Path": "gms.db"
  },
  "Jwt": {
    "Issuer": "gms.api",
    "Audience": "gms.clients",
    "Key": "dev-only-signing-secret-change-me-before-production-0123456789",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
