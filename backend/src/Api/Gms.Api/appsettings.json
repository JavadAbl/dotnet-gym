{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Identity": "Data Source=data/gms-identity.db",
    "Branches": "Data Source=data/gms-branches.db",
    "Catalog": "Data Source=data/gms-catalog.db",
    "Members": "Data Source=data/gms-members.db",
    "Wallet": "Data Source=data/gms-wallet.db",
    "Sales": "Data Source=data/gms-sales.db",
    "Attendance": "Data Source=data/gms-attendance.db",
    "Coaching": "Data Source=data/gms-coaching.db",
    "Buffet": "Data Source=data/gms-buffet.db",
    "Audit": "Data Source=data/gms-audit.db"
  },
  "Jwt": {
    "Issuer": "Gms.Api",
    "Audience": "Gms.Clients",
    "Key": "DEV-ONLY-gms-signing-key-change-me-in-production-0123456789",
    "ExpiresMinutes": 480
  },
  "RateLimiting": {
    "GlobalTokenLimit": 200,
    "GlobalTokensPerPeriod": 100,
    "GlobalReplenishSeconds": 10,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60
  }
}
